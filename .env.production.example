# Production Environment Variables for Netlify
# Copy these to Netlify: Site settings → Environment variables

# Sanity Configuration (REQUIRED)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id-here
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=your-read-token-here

# Optional: For preview/draft mode
SANITY_API_WRITE_TOKEN=your-write-token-here

# Site URL (auto-set by Netlify, but you can override)
NEXT_PUBLIC_SITE_URL=https://your-site-name.netlify.app
