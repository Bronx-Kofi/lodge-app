# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/studio/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# sanity
/.sanity/
/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Env files created by scripts for working locally
.env
.env.local

# Temporary files
tmp_*
*.log

# Generated by next-sitemap during builds
/public/sitemap.xml
/public/robots.txt

# Documentation (development notes - keep deployment docs)
*_COMPLETE.md
*_FIX*.md
*_FIXED.md
*_RESOLVED.md
*_NOTE.md
*_INFO.md
DEBUG_*.md
IMMEDIATE_*.md
BRANDING_*.md
CALENDAR_*.md
PORTAL_*.md
KINDLE_*.md
SMALL_*.md
FINAL_*.md
HERO_*.md
ROOM_DESCRIPTION_*.md
